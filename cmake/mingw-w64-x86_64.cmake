# Cross build for 64-bit Windows with MinGW-w64 (Arch: pacman -S mingw-w64-gcc). SDL3 comes from the official
# SDL3-devel-<version>-mingw package unpacked in tools/external (the newest one there is used).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(MINGW_TRIPLE x86_64-w64-mingw32)
set(CMAKE_C_COMPILER ${MINGW_TRIPLE}-gcc)
set(CMAKE_CXX_COMPILER ${MINGW_TRIPLE}-g++)
set(CMAKE_RC_COMPILER ${MINGW_TRIPLE}-windres)
file(GLOB SDL3_MINGW_PACKAGES "${CMAKE_CURRENT_LIST_DIR}/../tools/external/SDL3-*/${MINGW_TRIPLE}")
list(SORT SDL3_MINGW_PACKAGES COMPARE NATURAL ORDER DESCENDING)
list(GET SDL3_MINGW_PACKAGES 0 SDL3_MINGW)
set(CMAKE_FIND_ROOT_PATH /usr/${MINGW_TRIPLE} "${SDL3_MINGW}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
